  "components": {
    "schemas": {
      "Category": {
        "required": [
          "categoryName",
          "eventID"
        ],
        "type": "object",
        "properties": {
          "categoryID": {
            "type": "integer",
            "format": "int32"
          },
          "eventID": {
            "type": "integer",
            "format": "int32"
          },
          "categoryName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "distanceKM": {
            "type": "number",
            "format": "double"
          },
          "entryFee": {
            "type": "number",
            "format": "double"
          },
          "ageGroup": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "description": {
            "maxLength": 300,
            "type": "string",
            "nullable": true
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          }
        },
        "additionalProperties": false
      },
      "Enrolment": {
        "required": [
          "categoryID",
          "enrolmentDate",
          "eventID",
          "participantID",
          "paymentStatus",
          "raceNumber"
        ],
        "type": "object",
        "properties": {
          "enrolmentID": {
            "type": "integer",
            "format": "int32"
          },
          "eventID": {
            "type": "integer",
            "format": "int32"
          },
          "categoryID": {
            "type": "integer",
            "format": "int32"
          },
          "participantID": {
            "type": "integer",
            "format": "int32"
          },
          "enrolmentDate": {
            "type": "string",
            "format": "date-time"
          },
          "raceNumber": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "paymentStatus": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "participant": {
            "$ref": "#/components/schemas/RaceDayUser"
          }
        },
        "additionalProperties": false
      },
      "Event": {
        "required": [
          "createdAt",
          "eventDate",
          "eventName",
          "location",
          "organiserID",
          "registrationDeadline",
          "status"
        ],
        "type": "object",
        "properties": {
          "eventID": {
            "type": "integer",
            "format": "int32"
          },
          "organiserID": {
            "type": "integer",
            "format": "int32"
          },
          "eventName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "registrationDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "organiser": {
            "$ref": "#/components/schemas/RaceDayUser"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RaceDayUser": {
        "required": [
          "createdAt",
          "email",
          "firstName",
          "lastName",
          "passwordHash",
          "role"
        ],
        "type": "object",
        "properties": {
          "userID": {
            "type": "integer",
            "format": "int32"
          },
          "firstName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "passwordHash": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "RegisterRequest": {
        "required": [
          "email",
          "firstName",
          "lastName",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Result": {
        "required": [
          "enrolmentID",
          "status"
        ],
        "type": "object",
        "properties": {
          "resultID": {
            "type": "integer",
            "format": "int32"
          },
          "enrolmentID": {
            "type": "integer",
            "format": "int32"
          },
          "finishTime": {
            "type": "string",
            "format": "date-span",
            "nullable": true
